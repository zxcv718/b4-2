# source scripts/agent.env  — 케이스별 값은 호출 전에 export 하면 그 값이 유지된다
export AGENT_HOME="${AGENT_HOME:-$HOME/agent}"
export AGENT_PORT=15034
export AGENT_UPLOAD_DIR="$AGENT_HOME/upload_files"
export AGENT_KEY_PATH="$AGENT_HOME/api_keys"
export AGENT_LOG_DIR="$AGENT_HOME/logs"
export MEMORY_LIMIT="${MEMORY_LIMIT:-256}"
export CPU_MAX_OCCUPY="${CPU_MAX_OCCUPY:-50}"
export MULTI_THREAD_ENABLE="${MULTI_THREAD_ENABLE:-false}"
export PYTHONUNBUFFERED=1   # 파일 리다이렉트 시 SIGKILL 직전 로그 유실 방지

mkdir -p "$AGENT_UPLOAD_DIR" "$AGENT_KEY_PATH" "$AGENT_LOG_DIR"
[ -f "$AGENT_KEY_PATH/secret.key" ] || printf 'agent_api_key_test' > "$AGENT_KEY_PATH/secret.key"
